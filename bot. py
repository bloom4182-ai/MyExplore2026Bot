import os
import sqlite3
import numpy as np
import faiss
from datetime import datetime
from telegram import Update
from telegram.ext import Application, CommandHandler, MessageHandler, filters, ContextTypes
from sentence_transformers import SentenceTransformer

# 从环境变量读取（Railway 会设置）
TOKEN = os.getenv("8753452624:AAHuDDvqnlibZ7wRdWG5Me-tJygMoMu5qn8")
OWNER_ID = int(os.getenv("drift511", "0"))

if not TOKEN:
    raise ValueError("请设置 TOKEN 环境变量")

print("正在加载语义模型，请稍等...")
model = SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')
print("模型加载完成！")

index = None
id_to_content = {}

def init_db():
    global index, id_to_content
    conn = sqlite3.connect("knowledge.db")
    c = conn.cursor()
    c.execute('''
        CREATE TABLE IF NOT EXISTS notes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            content TEXT NOT NULL,
            embedding BLOB,
            created_at TEXT
        )
    ''')
    conn.commit()

    c.execute("SELECT id, content, embedding FROM notes")
    rows = c.fetchall()
    conn.close()

    if rows:
        embeddings = []
        for row in rows:
            note_id, content, emb_blob = row
            emb = np.frombuffer(emb_blob, dtype=np.float32)
            embeddings.append(emb)
            id_to_content[note_id] = content
        
        embeddings = np.array(embeddings).astype('float32')
        dimension = embeddings.shape[1]
        index = faiss.IndexFlatIP(dimension)
        faiss.normalize_L2(embeddings)
        index.add(embeddings)
        print(f"已加载 {len(rows)} 条历史知识")
    else:
        dimension = 384
        index = faiss.IndexFlatIP(dimension)
        print("知识库为空，等待添加内容")

def is_owner(update: Update) -> bool:
    return update.effective_user and update.effective_user.id == OWNER_ID

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not is_owner(update):
        await update.message.reply_text("⛔ 此机器人仅限主人使用")
        return
    await update.message.reply_text(
        "👋 你好！我是你的个人语义知识库机器人\n\n"
        "【使用方法】\n"
        "1. 直接发送任何文字 → 自动保存（语义理解）\n"
        "2. /search 关键词或句子 → 语义搜索\n"
        "3. /help → 查看帮助"
    )

async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not is_owner(update):
        return
    await update.message.reply_text(
        "📖 使用说明：\n\n"
        "• 直接发消息 = 保存到知识库（会理解意思）\n"
        "• /search 查询内容 = 语义搜索\n"
        "示例：\n"
        "/search 关于探索的内容\n"
        "/search 我之前存的收藏方法"
    )

async def save_note(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not is_owner(update):
        await update.message.reply_text("⛔ 此机器人仅限主人使用")
        return

    text = update.message.text
    if not text or text.startswith('/'):
        return

    embedding = model.encode([text], normalize_embeddings=True)[0].astype('float32')

    conn = sqlite3.connect("knowledge.db")
    c = conn.cursor()
    c.execute(
        "INSERT INTO notes (content, embedding, created_at) VALUES (?, ?, ?)",
        (text, embedding.tobytes(), datetime.now().strftime("%Y-%m-%d %H:%M:%S"))
    )
    note_id = c.lastrowid
    conn.commit()
    conn.close()

    global index, id_to_content
    emb = embedding.reshape(1, -1)
    index.add(emb)
    id_to_content[note_id] = text

    await update.message.reply_text("✅ 已语义保存到知识库")

async def search(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not is_owner(update):
        await update.message.reply_text("⛔ 此机器人仅限主人使用")
        return

    if not context.args:
        await update.message.reply_text("请输入要搜索的内容\n例如：/search 探索相关的笔记")
        return

    query = " ".join(context.args)
    
    if index.ntotal == 0:
        await update.message.reply_text("知识库还是空的，先发点内容给我吧")
        return

    query_emb = model.encode([query], normalize_embeddings=True).astype('float32')
    scores, indices = index.search(query_emb, k=min(8, index.ntotal))

    reply = f"🔍 语义搜索「{query}」的结果：\n\n"
    found = False
    note_ids = list(id_to_content.keys())
    
    for score, idx in zip(scores[0], indices[0]):
        if idx == -1 or idx >= len(note_ids):
            continue
        note_id = note_ids[idx]
        content = id_to_content[note_id]
        short = content[:180] + "..." if len(content) > 180 else content
        reply += f"• {short}\n（相似度：{score:.2f}）\n\n"
        found = True

    if not found:
        reply = f"没有找到与「{query}」语义相关的内容"
    
    await update.message.reply_text(reply)

def main():
    init_db()
    app = Application.builder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("help", help_command))
    app.add_handler(CommandHandler("search", search))
    app.add_handler(MessageHandler(filters.TEXT & \~filters.COMMAND, save_note))

    print("语义知识库机器人已启动...")
    app.run_polling()

if __name__ == "__main__":
    main()